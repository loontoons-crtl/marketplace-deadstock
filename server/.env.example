# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Include a database name after the host, e.g. /deadstock
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/deadstock?retryWrites=true&w=majority

# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

PORT=4000

# Frontend origin(s) allowed to send logged-in requests, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# 'console' prints phone OTPs in this terminal instead of sending SMS. Development only.
SMS_PROVIDER=console

# Listing photos.
# Leave CLOUDINARY_URL empty in development: photos are saved in server/uploads.
# For production, create a free Cloudinary account and paste the "API environment variable"
# from Cloudinary → Settings → API Keys. It looks like cloudinary://KEY:SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Razorpay (Dashboard → Account & Settings → API Keys). Use TEST mode keys while developing.
# Leave empty to switch online payment off; admins can still record offline (UPI / bank) payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://YOUR-API-DOMAIN/api/billing/webhook with events
# payment.captured, payment.failed and order.paid, and paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=

# 'console' prints renewal reminders in this terminal instead of emailing them. Development only.
EMAIL_PROVIDER=console

# Hourly job that sends renewal reminders and end-of-plan notices. Set to false on extra API copies.
RUN_JOBS=true

# NODE_ENV=production   (set by your host in production)
